# Maven
target/
**/target/
*.class
*.jar
*.war

# IntelliJ
.idea/
**/.idea/
*.iml
*.iws
*.ipr

# Mac
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# Docker volumes
docker/data/

# BaseX content image build snapshot (regenerated by scripts/publish/build_basex_image.sh
# from the live local BaseX container — large, must never be committed)
docker/basex-content/data/

# Spring Boot
*.log
application-local.properties

# Transcripts — raw VTT files not committed, but arguments.json is,
# and so are the translator-note ledgers (notes-*.json): the app Dockerfile
# bakes both into the image, so they must be in git to reach prod.
transcripts/**/*.vtt
transcripts/**/*.txt
transcripts/**/*.info.json
transcripts/downloaded.txt
!transcripts/arguments.json
!transcripts/notes-*.json
!transcripts/README.md

# Automation — secrets and run logs (the scripts and plists ARE committed)
automation/.mysql_pw
automation/logs/
backups/

# transcript enrichment leftovers
transcripts/__pycache__/
transcripts/arguments.json.bak
transcripts/arguments.json.pre-*

# Python bytecode
__pycache__/
*.pyc

# Local runtime state (not artifacts)
# The liveness ledger is per-machine: it records what THIS machine observed and
# when, is rewritten every weekly run, and would conflict on every pull while
# telling a second machine nothing true about its own observations.
transcripts/video_liveness.json
.search_corpus_hash
transcripts/.ollama_extract.pid
transcripts/.refresh_status.json
app/src/main/frontend/generated/

# Printer-sample build artefacts: regenerated from the corpus by
# scripts/print/build_print_sample.py and scripts/print/build_edition.py, so committing them
# would freeze a copy that silently goes stale as the corpus changes.
print-sample.html
out/

# Scratch the device bridge could not delete (it has no rm). Contents are stale
# copies and a stray git index.lock — never anything to commit.
_to_delete/

# Raw upstream source downloads — re-fetchable from the provider and far too
# large for git (the Språkbanken Vasa NT alone is 75MB uncompressed). The
# Vasa material was rejected after inspection; see docs/agricola-vasa-sourcing.md
# and the blocked queue row. Nothing here is an input the build needs.
sources/
