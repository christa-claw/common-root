    {
      "name": "A6 (1/3) Fetch KJV John 3:16 — saves the bundle for verify",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts/kjv/JHN.3.16",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('attestation present', () => pm.expect(b.attestation).to.have.keys('alg','kid','canon','corpus','minted','app','tag'));",
              "pm.test('no pilcrow in JSON text', () => pm.expect(b.verses[0].text).to.not.include('\\u00B6'));",
              "pm.test('header tag equals body tag', () => pm.expect(pm.response.headers.get('X-CommonRoot-Attestation')).to.include('tag=' + b.attestation.tag));",
              "const bundle = { text: b.text, ref: b.ref, attestation: b.attestation, verses: b.verses };",
              "pm.collectionVariables.set('bundle', JSON.stringify(bundle));",
              "const tampered = JSON.parse(JSON.stringify(bundle)); tampered.verses[0].text = tampered.verses[0].text.replace('loved', 'liked');",
              "pm.collectionVariables.set('bundleTampered', JSON.stringify(tampered));"
            ]
          }
        }
      ]
    },
    {
      "name": "A6 (2/3) Verify unmodified → valid:true",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/verify",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{bundle}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('valid', () => pm.expect(b.valid).to.be.true);",
              "pm.test('says what it attests', () => pm.expect(b.attests).to.include('unmodified'));",
              "pm.test('corpus is current', () => pm.expect(pm.response.json().corpus).to.eql('current'));"
            ]
          }
        }
      ]
    },
    {
      "name": "A7 (3/3) Verify tampered (loved→liked) → valid:false, no reason",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/verify",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{bundleTampered}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('invalid', () => pm.expect(b.valid).to.be.false);",
              "pm.test('no oracle: body is exactly {valid:false}', () => pm.expect(Object.keys(b)).to.eql(['valid']));"
            ]
          }
        }
      ]
    },
    {
      "name": "A6 Cross-edition bundle — 1 John 5:7 in KJV, WEB, Vulgate, TR (one tag)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/passages?refs=kjv:1JN.5.7,web:1JN.5.7,vul:1JN.5.7,tr:1JN.5.7",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('four editions, in asked order', () => pm.expect(b.passages.map(p => p.text)).to.eql(['kjv','web','vul','tr']));",
              "pm.test('one attestation for the whole comparison', () => pm.expect(b.attestation.tag).to.have.lengthOf(64));",
              "pm.collectionVariables.set('bundleX', JSON.stringify({ attestation: b.attestation, passages: b.passages.filter(p => p.found).map(p => ({ text: p.text, ref: p.ref, verses: p.verses })) }));"
            ]
          }
        }
      ]
    },
    {
      "name": "A6 Verify the cross-edition bundle → valid:true",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/verify",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{bundleX}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('valid', () => pm.expect(pm.response.json().valid).to.be.true);",
              "pm.test('names every edition', () => pm.expect(pm.response.json().attests).to.include('kjv').and.include('tr'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Q8 Burst — run this with the Collection Runner, 61+ iterations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Iterations 1–60 within a minute pass; the 61st is 429 with Retry-After ≤ 60.",
              "if (pm.response.code === 429) {",
              "  pm.test('429 carries Retry-After', () => pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.within(1, 60));",
              "  pm.test('quota_exceeded body', () => pm.expect(pm.response.json().error).to.eql('quota_exceeded'));",
              "} else {",
              "  pm.test('allowed while under burst', () => pm.expect(pm.response.headers.has('X-RateLimit-Remaining')).to.be.true);",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
