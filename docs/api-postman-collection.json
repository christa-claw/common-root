{
  "info": {
    "name": "Common Root API v1 (dev)",
    "description": "Exercises what exists of /api/v1 so far: the health endpoint and the key/quota gate (docs/api-spec.md §2, §3.1, §5; docs/api-test-cases.md H*, K*, Q*). Set the collection variables `baseUrl` and `apiKey`. Scripture routes (texts, chapter, passages) are live; attestation + verify are live; comments and downloads-behind-key are not built yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://common-root.org"
    },
    {
      "key": "apiKey",
      "value": "crk_REPLACE_WITH_YOUR_KEY"
    },
    {
      "key": "kjvEtag",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "H1/H5 Health — no auth, no quota",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok or 503 degraded, never 401', () => pm.expect([200, 503]).to.include(pm.response.code));",
              "const b = pm.response.json();",
              "pm.test('status matches code', () => pm.expect(b.status).to.eql(pm.response.code === 200 ? 'ok' : 'degraded'));",
              "pm.test('subsystems listed', () => pm.expect(b.subsystems).to.have.keys('mysql', 'basex', 'meilisearch'));",
              "pm.test('no rate headers on health', () => pm.expect(pm.response.headers.has('X-RateLimit-Limit')).to.be.false);"
            ]
          }
        }
      ]
    },
    {
      "name": "K8 Missing key → 401 missing_key",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "const b = pm.response.json();",
              "pm.test('error shape', () => pm.expect(b).to.have.keys('status', 'error', 'message', 'docs'));",
              "pm.test('missing_key', () => pm.expect(b.error).to.eql('missing_key'));"
            ]
          }
        }
      ]
    },
    {
      "name": "K8 Wrong scheme → 401",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic Zm9vOmJhcg=="
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 not 500', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "K7 Key in query string → 401 even though valid",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts?key={{apiKey}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('names the reason', () => pm.expect(pm.response.json().error).to.eql('key_in_query_string'));",
              "pm.test('tells you to rotate', () => pm.expect(pm.response.json().message).to.include('rotate'));",
              "pm.test('not counted', () => pm.expect(pm.response.headers.has('X-RateLimit-Remaining')).to.be.false);"
            ]
          }
        }
      ]
    },
    {
      "name": "K5 Unknown key → 401 invalid_key",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer crk_0000000000000000000000000000000000000000"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('invalid_key', () => pm.expect(pm.response.json().error).to.eql('invalid_key'));"
            ]
          }
        }
      ]
    },
    {
      "name": "K4/Q4 Valid key → passes the gate, rate headers present",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('not 401/429', () => pm.expect([401, 429]).to.not.include(pm.response.code));",
              "pm.test('X-RateLimit-Limit', () => pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('20000'));",
              "const remaining = Number(pm.response.headers.get('X-RateLimit-Remaining'));",
              "pm.test('remaining is a number below the limit', () => pm.expect(remaining).to.be.below(20000));",
              "pm.test('reset is an epoch in the future', () => pm.expect(Number(pm.response.headers.get('X-RateLimit-Reset'))).to.be.above(Date.now() / 1000));",
              "// Q1: run this request twice and watch Remaining drop by exactly one.",
              "const prev = pm.collectionVariables.get('lastRemaining');",
              "if (prev !== undefined && prev !== null && prev !== '') pm.test('remaining dropped by 1 since last run', () => pm.expect(remaining).to.eql(Number(prev) - 1));",
              "pm.collectionVariables.set('lastRemaining', String(remaining));"
            ]
          }
        }
      ]
    },
