    {
      "name": "D1 Download KJV — whole edition XML, bytes metered",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts/kjv/download",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 XML', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('xml'); });",
              "pm.test('attachment named after the token', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('kjv.xml'));",
              "pm.test('strong ETag names edition@corpus', () => pm.expect(pm.response.headers.get('ETag')).to.match(/^\"bible-kjv[^\"]*@[^\"]+\"$/));",
              "pm.test('corpus header', () => pm.expect(pm.response.headers.get('X-CommonRoot-Corpus')).to.be.a('string'));",
              "pm.test('is the authentic document, no site sequences', () => { const b = pm.response.text(); pm.expect(b).to.include('<text'); pm.expect(b).to.not.include('globalCanonicalSeq'); });",
              "pm.collectionVariables.set('kjvEtag', pm.response.headers.get('ETag'));"
            ]
          }
        }
      ]
    },
    {
      "name": "D2 Download again with If-None-Match → 304, counts nothing",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/texts/kjv/download",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
